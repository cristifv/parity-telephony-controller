<!-- WebRTC agents (TC ADR 0002 §5, R2-2): no session timer at all. freeswitch neither asks the
     browser to refresh nor refreshes it; liveness comes from ICE consent (parity-ms) and the WSS
     connection. The ws-binding serves the test browser; in production agents reach freeswitch
     through opensips. -->
<profile name="agents">
  <settings>
    <param name="context" value="agents"/>
    <param name="dialplan" value="XML"/>
    <param name="sip-ip" value="$${sip_ip}"/>
    <param name="rtp-ip" value="$${sip_ip}"/>
    <param name="ext-sip-ip" value="$${sip_ip}"/>
    <param name="ext-rtp-ip" value="$${sip_ip}"/>
    <param name="sip-port" value="5090"/>
    <param name="ws-binding" value="$${sip_ip}:5066"/>
    <param name="inbound-bypass-media" value="true"/>
    <param name="disable-transcoding" value="true"/>
    <param name="enable-timer" value="false"/>
    <param name="auth-calls" value="true"/>
    <param name="apply-register-acl" value=""/>
    <param name="force-register-domain" value="$${sip_ip}"/>
    <param name="force-register-db-domain" value="$${sip_ip}"/>
    <param name="inbound-codec-prefs" value="PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="PCMU,PCMA"/>
    <param name="manage-presence" value="false"/>
  </settings>
</profile>
